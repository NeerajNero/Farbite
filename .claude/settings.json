{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/next-app-guard.sh",
            "timeout": 15,
            "statusMessage": "Checking vendored-file guard..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "fp=$(jq -r '.tool_input.file_path // empty'); if [ -n \"$fp\" ] && echo \"$fp\" | grep -qE '\\.(ts|tsx)$' && ! echo \"$fp\" | grep -q 'generated'; then npx prettier --write \"$fp\" >/dev/null 2>&1 || true; fi"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/next-app-check.sh",
            "timeout": 180,
            "statusMessage": "Linting + type-checking Next.js app..."
          }
        ]
      }
    ]
  }
}